# Tailscale API token (requires AuthKeys permission)
# Generate from Tailscale admin console.
TAILSCALE_API_TOKEN="tskey-api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Tailnet identifier used in Tailscale API path (example: ts-xxxx)
TAILNET_ID="your_tailnet_id_here"

# SSH public key to place into authorized_keys for the bootstrap user
# Example: content of ~/.ssh/id_rsa.pub
ANSIBLE_SSH_PUB_KEY="$(cat ~/.ssh/id_rsa.pub)"

# Bootstrap user to create/grant sudo access
USERNAME="ansible"

# Access mode switches:
# Both values must be explicitly set to true or false.
# - USE_LEGACY_SSH_KEY=true  -> include --sshkey
# - USE_LEGACY_SSH_KEY=false -> add --skip-ssh-key
# - TAILSCALE_SSH=true       -> add --enable-tailscale-ssh
# - TAILSCALE_SSH=false      -> add --disable-tailscale-ssh
USE_LEGACY_SSH_KEY="true"
TAILSCALE_SSH="true"

# Hosted URL for post-init/post-init.sh
POST_INIT_SH_URL="https://cdn.jsdelivr.net/gh/qgp9/run-sh@v0.3.0/post-init/post-init.sh"
